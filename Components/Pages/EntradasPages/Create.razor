@page "/Entradas"
@page "/Entradas/Create"
@inject EntradaServices entradasService
@inject LibroService librosService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>@(Entrada.EntradaId > 0 ? "Modificar Entrada" : "Crear Entrada")</PageTitle>

<EditForm Model="Entrada" FormName="EntradaForm" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container my-4">
        <div class="card shadow-sm border">
            @* Encabezado con título centrado *@
            <div class="card-header bg-white py-3 border-bottom text-center">
                <h3 class="card-title mb-0 fs-4 text-secondary fw-normal">
                    @(Entrada.EntradaId > 0 ? "Modificar Entrada" : "Crear Entrada")
                </h3>
            </div>

            <div class="card-body p-4">
                @* Toast / Mensajes de alerta *@
                @if (!string.IsNullOrEmpty(mensajeToast))
                {
                    <div class="alert alert-@tipoToast alert-dismissible fade show mb-4" role="alert">
                        @mensajeToast
                        <button type="button" class="btn-close" @onclick="() => mensajeToast = string.Empty"></button>
                    </div>
                }

                @* Fila 1: EntradaId a la izquierda y Fecha a la derecha *@
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-semibold">EntradaId</label>
                        <input type="number" class="form-control" value="@Entrada.EntradaId" readonly disabled />
                    </div>

                    <div class="col-md-6 text-md-end">
                        <label class="form-label text-secondary fw-semibold d-block text-start text-md-end">Fecha</label>
                        <div class="d-inline-block w-100" style="max-width: 250px;">
                            <InputDate @bind-Value="Entrada.Fecha" class="form-control" />
                            <ValidationMessage For="@(() => Entrada.Fecha)" />
                        </div>
                    </div>
                </div>

                @* Fila 2: Concepto *@
                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Concepto</label>
                    <InputText @bind-Value="Entrada.Concepto" class="form-control" />
                    <ValidationMessage For="@(() => Entrada.Concepto)" />
                </div>

                @* Fila 3: Total *@
                <div class="mb-4">
                    <label class="form-label text-secondary fw-semibold">Total</label>
                    <input type="number" class="form-control" value="@Entrada.Total" readonly disabled />
                </div>

                @* Sección Detalle: Detalles de la Entrada *@
                <div class="border rounded p-3 mb-4 bg-light-subtle">
                    <h5 class="text-secondary fw-normal mb-3">Detalles de la Entrada</h5>

                    @* Fila de controles de detalle *@
                    <div class="row g-3 align-items-center mb-3">
                        <div class="col-md-6 d-flex align-items-center gap-2">
                            <label class="form-label text-secondary fw-semibold mb-0 text-nowrap">Seleccione:</label>
                            <InputSelect @bind-Value="libroSeleccionadoId" class="form-select">
                                <option value="0">-- Seleccione un libro --</option>
                                @foreach (var libro in listaLibros)
                                {
                                    <option value="@libro.LibroId">@libro.Titulo (Cantidad Disponible: @libro.CantidadDisponible)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4 d-flex align-items-center gap-2">
                            <label class="form-label text-secondary fw-semibold mb-0 text-nowrap">Cantidad:</label>
                            <InputNumber @bind-Value="cantidadDetalle" class="form-control" min="1" />
                        </div>

                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-secondary px-3" @onclick="AgregarDetalle">
                                + Agregar
                            </button>
                        </div>
                    </div>

                    @* Tabla del detalle *@
                    <div class="table-responsive mb-2">
                        <table class="table align-middle mb-0 bg-white border">
                            <thead>
                                <tr class="text-secondary border-bottom">
                                    <th>Libro</th>
                                    <th>Cantidad</th>
                                    <th class="text-center">Remover</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Entrada.EntradaDetalle.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">No se han agregado detalles.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Entrada.EntradaDetalle)
                                    {
                                        <tr>
                                            <td>@ObtenerTituloLibro(item.LibroId)</td>
                                            <td>@item.Cantidad</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => EliminarDetalle(item)">
                                                    <i class="bi bi-trash"></i> Remover
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Botones Inferiores *@
                <div class="d-flex justify-content-center gap-2 pt-2">
                    <a href="Entradas/Index" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-floppy me-1"></i> Guardar
                    </button>
                    @if (mostrarBotonEliminar)
                    {
                        <button type="button" class="btn btn-danger px-4" @onclick="Eliminar">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int EntradaId { get; set; }

    public Entradas Entrada { get; set; } = new Entradas();
    public List<Libros> listaLibros { get; set; } = new List<Libros>();

    private int libroSeleccionadoId = 0;
    private int cantidadDetalle = 1;
    private bool mostrarBotonEliminar = false;

    private string mensajeToast = string.Empty;
    private string tipoToast = "info";

    protected override async Task OnInitializedAsync()
    {
        var resultLibros = await librosService.GetList(l => true);
        if (resultLibros.IsSuccess && resultLibros.Value != null)
        {
            listaLibros = resultLibros.Value;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EntradaId > 0)
        {
            await Buscar();
        }
        else
        {
            Nuevo();
        }
    }

    public void Nuevo()
    {
        Entrada = new Entradas();
        libroSeleccionadoId = 0;
        cantidadDetalle = 1;
        mostrarBotonEliminar = false;
    }

    public async Task Buscar()
    {
        if (EntradaId <= 0) return;

        var result = await entradasService.Buscar(EntradaId);
        if (result.IsSuccess && result.Value != null)
        {
            Entrada = result.Value;
            mostrarBotonEliminar = true;
            CalcularTotal();
        }
        else
        {
            MostrarToast("No se encontró ninguna entrada con ese ID.", "danger");
            mostrarBotonEliminar = false;
        }
    }

    public void AgregarDetalle()
    {
        if (libroSeleccionadoId <= 0)
        {
            MostrarToast("Debe seleccionar un libro.", "warning");
            return;
        }

        if (cantidadDetalle <= 0)
        {
            MostrarToast("La cantidad debe ser mayor a 0.", "warning");
            return;
        }

        var existe = Entrada.EntradaDetalle.FirstOrDefault(d => d.LibroId == libroSeleccionadoId);
        if (existe != null)
        {
            existe.Cantidad += cantidadDetalle;
        }
        else
        {
            Entrada.EntradaDetalle.Add(new EntradaDetalle
            {
                EntradaId = Entrada.EntradaId,
                LibroId = libroSeleccionadoId,
                Cantidad = cantidadDetalle
            });
        }

        CalcularTotal();
        libroSeleccionadoId = 0;
        cantidadDetalle = 1;
        MostrarToast("Detalle agregado.", "info");
    }

    public void EliminarDetalle(EntradaDetalle item)
    {
        Entrada.EntradaDetalle.Remove(item);
        CalcularTotal();
        MostrarToast("Detalle eliminado.", "info");
    }

    private void CalcularTotal()
    {
        Entrada.Total = Entrada.EntradaDetalle.Sum(d => d.Cantidad);
    }

    private string ObtenerTituloLibro(int libroId)
    {
        var libro = listaLibros.FirstOrDefault(l => l.LibroId == libroId);
        return libro != null ? libro.Titulo : $"Libro #{libroId}";
    }

    public async Task Guardar()
    {
        if (Entrada.EntradaDetalle.Count == 0)
        {
            MostrarToast("Debe agregar al menos un libro al detalle.", "warning");
            return;
        }

        CalcularTotal();

        if (!mostrarBotonEliminar)
        {
            Entrada.EntradaId = 0;
        }

        var result = await entradasService.Guardar(Entrada);

        if (result.IsSuccess)
        {
            MostrarToast("Entrada guardada e inventario actualizado correctamente.", "success");
            navigationManager.NavigateTo("/Entradas/Index");
        }
        else
        {
            MostrarToast("Error al guardar la entrada.", "danger");
        }
    }

    public async Task Eliminar()
    {
        if (Entrada.EntradaId <= 0) return;

        var result = await entradasService.Eliminar(Entrada.EntradaId);
        if (result.IsSuccess)
        {
            MostrarToast("Entrada eliminada e inventario reajustado correctamente.", "success");
            navigationManager.NavigateTo("/Entradas/Index");
        }
        else
        {
            MostrarToast("Error al eliminar la entrada.", "danger");
        }
    }

    private void MostrarToast(string mensaje, string tipo)
    {
        mensajeToast = mensaje;
        tipoToast = tipo;
    }
}