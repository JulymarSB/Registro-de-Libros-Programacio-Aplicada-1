@page "/Prestamos/Index"
@rendermode InteractiveServer
@inject PrestamoService prestamoService
@inject IToastService toastService
@using Microsoft.AspNetCore.Components.QuickGrid


<PageTitle> Listado de Préstamos </PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white text-center">
            <h3><strong>Listado de Prestamos</strong></h3>
        </div>
        
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <a href="/Prestamos/Create" class="btn btn-success">
                        <i class="btn btn-primary"></i> Crear
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                @*Implementación del QuickGrid*@
                <QuickGrid Items="@prestamos" Pagination="@pagination" Class="table table-striped table-bordered">
                    <PropertyColumn Property="@(p => p.PrestamoId)" Title="ID" Sortable="true" />
                    <PropertyColumn Property="@(p => p.EstudianteId)" Title="ID Estudiante" Sortable="true" />
                    <PropertyColumn Property="@(p => p.LibroId)" Title="ID Libro" Sortable="true" />
                    <PropertyColumn Property="@(p => p.FechaPrestamo)" Title="Prestamo" Format="dd/MM/yyyy" Sortable="true" />
                    <PropertyColumn Property="@(p => p.FechaDevolucion)" Title="Devolucion" Format="dd/MM/yyyy" Sortable="true" />
                    
                    <TemplateColumn Title="Acciones">
                        <div class="d-flex gap-2">
                            @*Boton editar*@
                            <a href="/Prestamos/Edit/@context.PrestamoId" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i></a>

                            @*Boton devolver*@
                            @if (context.FechaDevolucion == null || context.FechaDevolucion == DateTime.MinValue)
                            {
                                <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalDevolucion(context.PrestamoId)" title="Devolver">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                </button>
                            }
                        </div>
                    </TemplateColumn>
                </QuickGrid>
                    <div class="card-footer d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <label class="me-4"><strong>Cantidad: </strong>@prestamos.Count()</label>
                            <label><strong>Promedio de días prestados: </strong>@PromedioDiasPrestados.ToString("N2") días</label>
                        </div>
    
                    </div>
            </div>
                @*Paginación del QuickGrid *@
                <div class="card-footer d-flex justify-content-center">
                <Paginator State="@pagination" />
            </div>
        </div>
    </div>
</div>

@* Modal de Confirmación para Devolución *@
@if(mostrarModalDevolucion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Devolución de Libro</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Fecha de Devolución</label>
                        <input type="date" class="form-control" @bind="fechaDevolucionSeleccionada" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmarDevolucion">
                        Confirmar Devolución
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private IQueryable<Prestamos> prestamos = Enumerable.Empty<Prestamos>().AsQueryable();
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 }; 
    private bool mostrarModalDevolucion = false;
    private int prestamoIdSeleccionado;
    private DateTime fechaDevolucionSeleccionada = DateTime.Now.Date;

    private bool mostrarModal = false;

    private void MostrarModal(int id)
    {
        prestamoIdSeleccionado = id;
        mostrarModal = true; 
    }

    private void CerrarModal()
    {
        mostrarModalDevolucion = false; 
    }

    private async Task EliminarConfirmado()
    {
        await prestamoService.Eliminar(prestamoIdSeleccionado);
        await CargarPrestamos();
        CerrarModal();
    }

    private double PromedioDiasPrestados
    {
        get
        {
            if (!prestamos.Any()) 
            {
                return 0;
            }

            var prestamosDevueltos = prestamos.Where(p => p.FechaDevolucion.HasValue).ToList();

            if (prestamosDevueltos.Count == 0) 
            {
                return 0;
            }
            return prestamosDevueltos.Average(p => (p.FechaDevolucion.Value.Date - p.FechaPrestamo.Date).TotalDays);
        }
    }

     protected override async Task OnInitializedAsync()
    {
        await CargarPrestamos();
    }

     private async Task CargarPrestamos()
    {
        var lista = await prestamoService.GetList(p => true);
        prestamos = lista.AsQueryable();
    }

    private void AbrirModalDevolucion(int id)
    {
        prestamoIdSeleccionado = id;
        fechaDevolucionSeleccionada = DateTime.Now.Date; 
        mostrarModalDevolucion = true; 
    }

    private async Task ConfirmarDevolucion()
    {
        // Llamamos al método Devolver que recibe la fecha por parámetro
        var exito = await prestamoService.Devolver(prestamoIdSeleccionado, fechaDevolucionSeleccionada);
        
        if (exito)
        {
            toastService.ShowSuccess("El préstamo ha sido devuelto con éxito.");
            await CargarPrestamos(); // Refresca la tabla y recalcula el promedio
            CerrarModal();
        }
        else
        {
            toastService.ShowError("Error al registrar la devolución. Verifique las fechas.");
        }
    }
}
