@page "/Estudiantes/Create"
@rendermode InteractiveServer
@inject EstudiantesService estudiantesService
@inject IToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Crear Estudiante</PageTitle>
<EditForm Model="Estudiante" OnValidSubmit="Guardar" FormName="EstudianteForm"> 
    <DataAnnotationsValidator />
    <div class="container">
        <div class="card-header">
            <h3><strong>Creat Estudiamte</strong></h3>
        </div>

            <div class="card-body">

                <div class="mb-3">
                    <label class"form-label">Nombres=</label>
                    <InputText class="form-control" @bind-Value="Estudiante.Nombres"/>
                    <ValidationMessage For="@(() => Estudiante.Nombres)"/>
                </div>

                <div class="mb-3">
                    <label class"form-label">Direccion=</label>
                    <InputText class="form-control" @bind-Value="Estudiante.Direccion"/>
                    <ValidationMessage For="@(() => Estudiante.Direccion)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email=</label>
                    <InputText class="form-control" @bind-Value="Estudiante.Email"/>
                    <ValidationMessage For="@(() => Estudiante.Email)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fecha de nacimiento=</label>
                    <InputDate class="form-control" @bind-Value="Estudiante.FechaNacimiento"/>
                    <ValidationMessage For="@(() => Estudiante.FechaNacimiento)"/>
                </div>
            <div class="card-footer text-center">
                <a href="/Estudiantes/Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi floppy"></i>Guardar</button>
            </div>
        </div>
    </div>
</EditForm>


@code{
    [Parameter]
    public int EstudianteId{ get; set; }

    [SupplyParameterFromForm]
    public Estudiantes Estudiante { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        Estudiante.FechaNacimiento = DateTime.Today;
    }

    private async Task Guardar()
    {
var result = await estudiantesService.Guardar(Estudiante);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Estudiante Guardado Correctamente");
            navigationManager.NavigateTo("/Estudiante/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("Ya existe un estudiante con ese nombre");
        });
    }
}
