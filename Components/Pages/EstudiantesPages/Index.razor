@page "/Estudiantes/Index"
@rendermode InteractiveServer
@inject IToastService toastService
@inject EstudiantesService estudiantesService

<PageTitle>Listado de Estudiantes</PageTitle>
<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3>Listado de Estudiantes</h3>
        <a href="Estudiantes/Create" class="btn btn-success"> 
            <i class="bi bi-plus-circle"></i> Crear nuevo estudiante</a>
    </div>

    <div class="card-body">
        @* Bloque de Filtros y Busqueda*@
        <div class="row mb-4 align-items-end">
            <div class="col-md-3">
                <label class="form-label"><strong>Filtrar por:</strong></label>
                <InputSelect class="form-select" @bind-Value="Filtro">
                    <option value="" selected disabled>Seleccione una opción</option>
                    <option value="nombres">Nombres</option>
                    <option value="direccion">Dirección</option>
                    <option value="email">Email</option>
                </InputSelect>
            </div>
            
            <div class="col-md-6">
                <label class="form-label"><strong>Búsqueda:</strong></label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="ValorFiltro" placeholder="Ingrese el valor a buscar..." />
                    <button type="button" class="btn btn-primary" @onclick="Buscar">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Restablecer">
                        <i class="bi bi-arrow-clockwise"></i> Restablecer
                    </button>
                </div>
            </div>
        </div>

        @if(ListaEstudiantes == null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (ListaEstudiantes.Count == 0){
            <div class="alert alert-info">No hay estudiantes registrados</div>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombres</th>
                        <th>Dirección</th>
                        <th>Email</th>
                        <th>Fecha nacimiento</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var estudiante in ListaEstudiantes)
                    {
                        <tr>
                            <td>@estudiante.EstudianteId</td>
                            <td>@estudiante.Nombres</td>
                            <td>@estudiante.Direccion</td>
                            <td>@estudiante.Email</td>
                            <td>@estudiante.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="/Estudiantes/Edit/@estudiante.EstudianteId" class="btn btn-outline-primary btn-sm">Editar</a>
                                <button class="btn btn-outline-danger" @onclick="() => Eliminar(estudiante.EstudianteId)">Eliminar</button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code{
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    public async Task Buscar()
    {
          if (string.IsNullOrWhiteSpace(ValorFiltro))
        {
            ListaEstudiantes = await estudiantesService.GetList(l => true);
        }
        else
        {
            if (Filtro == "id" && int.TryParse(ValorFiltro, out int idBuscado))
            {
                ListaEstudiantes = await estudiantesService.GetList(l => l.EstudianteId == idBuscado);
            }
            else if (Filtro == "titulo")
            {
                ListaEstudiantes = await estudiantesService.GetList(l => l.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
    }

    private async Task Eliminar(int estudianteId)
    {
        await estudiantesService.Eliminar(estudianteId);
        ListaEstudiantes = await estudiantesService.GetList(l => true);
    }
    public async Task Restablecer()
    {
        Filtro = "";
        ValorFiltro = "";
        ListaEstudiantes = await estudiantesService.GetList (e => true);
    }
}
