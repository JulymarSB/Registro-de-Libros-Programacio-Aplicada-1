@page "/libros/create"
@rendermode InteractiveServer

@inject LibroService libroService
@inject NavigationManager navigationManager
@inject IToastService toastService

<div class="card shadow">
    <div class="card-header">
        <h3>Registro de Libro</h3>
    </div>

    <div class="card-body">
        <EditForm Model="libro" OnValidSubmit="Guardar">
            <DataAnnotationsValidator/>
            <div class="mb-3">
                <label><strong>LibroId</strong></label>
                <InputNumber class="form-control" @bind-Value="libro.LibroId" readonly></InputNumber>
            </div>

            <div class="mb-3">
                <label><strong>Titulo</strong></label>
                <InputText class="form-control" @bind-Value="libro.Titulo"></InputText>
                <ValidationMessage For="(() => libro.Titulo)"/>
            </div>

            <div class="mb-3">
                <label><strong>Autor</strong></label>
                <InputText class=form-control" @bind-Value="libro.Autor"></InputText>
                <ValidationMessage For="(() => libro.Autor)" />
            </div>

            <div class="mb-3">
                <label><strong>Anio de Publicacion</strong></label>
                <InputNumber class="form-control" @bind-Value="libro.AnioPublicacion"></InputNumber>
                <ValidationMessage For="(() => libro.AnioPublicacion)" />
            </div>

            <div class="card-footer mt-3">
                <a href="/libros" class="btn btn-secondary"> Volver</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </EditForm>
    </div>
</div>

@code{
    public Libros libro {get; set;} = new Libros();

    public async Task Guardar(){
      var result = await libroService.Guardar(libro);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Libro Guardado Correctamente");
            navigationManager.NavigateTo("/Libro/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("Ya existe un libro con ese título");
        });  
    }
}
