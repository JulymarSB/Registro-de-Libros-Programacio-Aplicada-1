@using RegistroLibros.Models
@using RegistroLibros.Services
@page "/libros"
@rendermode InteractiveServer

@inject LibroService libroService
@inject NavigationManager navegacion

<div class="card shadow">
    <div class="card-header">
        <h3>Consulta de Libros</h3>
</div>

<div class="card-body">
    <div class="mb-3">
        <a href="/libros/create" class="btn-primary">+ Crear</a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>LibroId</th>
                <th>Titulo</th>
                <th>Autor</th>
                <th>Anio Publicacion</th>
                <th>Opciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in ListaLibros){
                <tr>
                    <td>@libro.LibroId</td>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.AnoPublicacion</td>
                    <td><a href="/libros/edit/@libro.LibroId" class="btn btn-warning">Editar</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="card-footer">
    <strong>Cantidad: @ListaLibros.Count</strong>
</div>
</div>

@code {
    public List<Libros> ListaLibros {get; set;} = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await libroService.Listar(l => true);
    }
}