@page "/Libros/Index"
@rendermode InteractiveServer
@inject LibroService libroService
@inject IToastService toastService
@inject NavigationManager navigationManager

<PageTitle> Index </PageTitle>
<div class="card shadow-lg">
    <div class="card-header d-flex justify-content-between align-center mb-4">
        <h3>Consulta de Libros</h3>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <a href="/libros/create" class="btn btn-primary"> <i class="bi bi-plus-square"></i>Crear</a>
        </div>
        <div class="row mb-3">
            @*Filtro*@
            <div class="col-md-3">
                <label><strong>Filtrar por</strong></label>
                <InputSelect class="form-select" @bind-Value="Filtro">
                    <option value="id">LibroId</option>
                    <option value="titulo">Título</option>
                </InputSelect>
            </div>

            @*Busqueda*@
            <div class="col-md-6">
                <label><strong>Búsqueda</strong></label>
                <div class="input-group">
                    <input class="form-control" @bind="ValorFiltro" placeholder="Buscar..." />
                    <button class="btn btn-outline-primary" type="button" @onclick="Buscar">
                        <span class="bi bi-search"></span> Buscar
                    </button>
                </div>
            </div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>LibroId</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Año Publicación</th>
                    <th>Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in ListaLibros){
                    <tr>
                        <td>@libro.LibroId</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.AnioPublicacion</td>
                        <td>
                            <a href="/libros/edit/@libro.LibroId" class="btn btn-outline-primary">Editar</a>
                            <button class="btn btn-outline-danger" @onclick="() => Eliminar(libro.LibroId)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="card-footer text-muted">
        <strong>Cantidad: @ListaLibros.Count</strong>
    </div>
</div>

@code {
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        var result = await libroService.GetList(l => l.LibroId >0);
        result.OnSuccess(libro => ListaLibros = libro!);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Titulo")
            {
                var result = await libroService.GetList(l => l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
                result.OnSuccess(libros => ListaLibros = libros);
            }
            else if (Filtro == "AnoPublicacion")
            {
                if (int.TryParse(ValorFiltro, out int anio))
                {
                    var result = await libroService.GetList(l => l.AnioPublicacion == anio);
                    result.OnSuccess(libros => ListaLibros = libros);
                }
            }
        }
        else
        {
            var result = await libroService.GetList(l => l.LibroId > 0);
            result.OnSuccess(libros => ListaLibros = libros);
        }
        
    }

    private async Task Eliminar(int libroId)
    {
        var result = await libroService.Eliminar(libroId);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha eliminado correctamente");
            navigationManager.NavigateTo("/Libro/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("No se ha podido eliminar correctamente");
        });
    }
}
