@using RegistroLibros.Models
@using RegistroLibros.Services
@page "/libros/edit/{LibroId:int}"
@rendermode InteractiveServer
@inject LibroService libroService
@inject NavigationManager navegacion
@inject IToastService toastService

<div class="card shadow">
    <div class="card-header">
        <h3>Modificar Libro</h3>
    </div>

    <div class="card-body">
        <EditForm Model="libro" OnValidSumit="Modificar">
            <DataAnnotationsValidator/>

            <div class="mb-3">
                <label><strong>LibroId</strong></label>
                <InputNumber class="form-control" @bind-Value="libro.LibroId" readonly></InputNumber>
            </div>

            <div class="mb-3">
                <label><strong>Titulo</strong></label>
                <InputText class="form-control" @bind-Value="libro.Titulo"></InputText>
                <ValidationMessage For="(() => libro.Titulo)"/>
            </div>

            <div class="mb-3">
                <label><strong>Autor</strong></label>
                <InputText class="form-control" @bind-Value="libro.Autor"></InputText>
                <ValidationMessage For="(()=>libro.Autor)"/>
            </div>

            <div class="mb-3">
                <label><strong>Anio de Publicacion</strong></label>
                <InputNumber class="form-control" @bind-Value="libro.AnoPublicacion"></InputNumber>
                <ValidationMessage For="(() => libro.AnoPublicacion)"/>
            </div>

            <div class="card-footer mt-3">
                <a href="/libros" class="btn btn-secondary"> Volver</a>
                <button type="submit" class="btn btn-primary">Modificar</button>
                <button type="button" class="btn btn-danger" @onclick="Eliminar">Eliminar</button>
            </div>
        </EditForm>
    </div>
</div>
@code {
    [Parameter]
    public int LibroId {get; set;}
    public Libros libro {get; set;} = new Libros();

    protected override async Task OnInitializedAsync(){
        var encontrado = await libroService.Buscar(LibroId);
        if (encontrado != null){
            libro = encontrado;
        }
    }

    public async Task Modificar(){
        await libroService.Guardar(libro);
        navegacion.NavigateTo("/libros");
    }

    public async Task Eliminar(){
        await libroService.Eliminar(libro.LibroId);
        navegacion.NavigateTo("/libros");
    }
}