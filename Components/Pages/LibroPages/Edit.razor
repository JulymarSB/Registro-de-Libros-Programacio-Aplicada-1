@page "/libros/edit/{LibroId:int}"
@rendermode InteractiveServer

@inject LibroService libroService
@inject NavigationManager navigationManager
@inject IToastService toastService

<div class="card shadow">
    <div class="card-header">
        <h3>Modificar Libro</h3>
    </div>

    <div class="card-body">
        <EditForm Model="Libro" OnValidSubmit="Modificar">
            <DataAnnotationsValidator/>
            <div class="mb-3">
                <label><strong>LibroId</strong></label>
                <InputNumber class="form-control" @bind-Value="Libro.LibroId" readonly></InputNumber>
            </div>

            <div class="mb-3">
                <label><strong>Titulo</strong></label>
                <InputText class="form-control" @bind-Value="Libro.Titulo"></InputText>
                <ValidationMessage For="(() => Libro.Titulo)"/>
            </div>

            <div class="mb-3">
                <label><strong>Autor</strong></label>
                <InputText class="form-control" @bind-Value="Libro.Autor"></InputText>
                <ValidationMessage For="(()=>Libro.Autor)"/>
            </div>

            <div class="mb-3">
                <label><strong>Anio de Publicacion</strong></label>
                <InputNumber class="form-control" @bind-Value="Libro.AnioPublicacion"></InputNumber>
                <ValidationMessage For="(() => Libro.AnioPublicacion)"/>
            </div>

            <div class="card-footer mt-3">
                <a href="/libros" class="btn btn-secondary"> Volver</a>
                <button type="submit" class="btn btn-primary">Modificar</button>
            </div>
        </EditForm>
    </div>
</div>
@code {
    [Parameter]
    public int LibroId {get; set;}
    public Libros Libro {get; set;} = new();

    protected override async Task OnInitializedAsync(){
        var result = await libroService.Buscar(LibroId);
        result.OnSuccess(libro => Libro = libro!);
    }

    private async Task Modificar(){
var result = await libroService.Guardar(Libro);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado exitosamente");
            navigationManager.NavigateTo("/Libro/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("Ya existe un libro con este título");
        });
    }
}
