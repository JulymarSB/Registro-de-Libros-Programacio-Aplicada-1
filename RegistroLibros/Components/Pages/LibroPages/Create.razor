@using RegistroLibros.Models
@using RegistroLibros.Services
@page "/libros/create"
@rendermode InteractiveServer

@inject LibroService libroService
@inject NavigationManager navegacion
@inject IToastService toastService

<div class="card shadow">
    <div class="card-header">
        <h3>Registro de Libro</h3>
    </div>

    <div class="card-body">
        @if(!string.IsNullOrEmpty(mensajeError))
        {
            <div class"alert alert-danger">
                @mensajeError
            </div>
        }

        <EditForm Model="libro" OnValidSubmit="Guardar">
            <DataAnnotationsValidator/>

            <div class="mb-3">
                <label><strong>LibroId</strong></label>
                <InputNumber class="form-control" @bind-Value="libro.LibroId" readonly></InputNumber>
            </div>

            <div class="mb-3">
                <label><strong>Titulo</strong></label>
                <InputText class="form-control" @bind-Value="libro.Titulo"></InputText>
                <ValidationMessage For="(() => libro.Titulo)"/>
            </div>

            <div class="mb-3">
                <label><strong>Autor</strong></label>
                <InputText class"form-control" @bind-Value="libro.Autor"></InputText>
                <ValidationMessage For="(() => libro.Autor)" />
            </div>

            <div class="mb-3">
                <label><strong>Anio de Publicacion</strong></label>
                <InputNumber class"form-control" @bind-Value="libro.AnoPublicacion"></InputNumber>
                <ValidationMessage For="(() => libro.AnoPublicacion)" />
            </div>

            <div class="card-footer mt-3">
                <a hred="/libros" class="btn btn-secondary"> Volver</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </EditForm>
    </div>
</div>

@code{
    public Libros libro {get; set;} = new Libros();
    public string mensajeError{get; set;} = " ";

    public async Task Guardar(){
        //Verificamos si existe el titulo en la base de datos
        bool existe = await libroService.ExisteLibro(libro.Titulo);

        if(existe)
        {
            toastService.ShowError("Error. Ese titulo ya existe");
            return;
        }
        //si el titulo no existe, se guarda el libro
        bool guardado = await libroService.Guardar(libro);

        if(guardado){
            toastService.ShowSuccess("Libro guardado exitosamente");
            navegacion.NavigateTo("/libros"); //para volver a la tabla
        }

    }
}